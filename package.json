{
  "name": "gerenciador-de-projetos",
  "version": "1.0.0",
  "description": "Gerenciador de projetos em JavaScript com POO, prompt-sync, Express e fs",
  "main": "index.js",
  "scripts": {
    "start": "node cli.js",
    "dev": "node --watch cli.js",
    "api": "node servidor.js",
